{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "eslint.config.js",
    "gui/src/operator/main.tsx",
    "tests/**/*.test.ts",
    "tests/setup/**/*.ts",
    "tests/fixtures/tiktok-sdk-contract.ts",
    "tests/fixtures/gui-runtime-media-lifetime.ts",
    "tests/fixtures/single-instance-process.ts"
  ],
  "project": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "gui/**/*.{ts,tsx}"
  ],
  "eslint": false,
  "ignore": [
    "src/interfaces/PlatformEvents.ts",
    "src/core/types/config-types.ts",
    "src/auth/twitch-oauth-scopes.ts",
    "tests/helpers/farewell-routing-harness.ts"
  ],
  "ignoreIssues": {
    "src/obs/connection.ts": [
      "exports"
    ],
    "src/services/innertube-instance-manager.ts": [
      "exports"
    ],
    "tests/helpers/**/*.js": [
      "exports"
    ],
    "tests/helpers/**/*.ts": [
      "exports"
    ]
  },
  "playwright": {
    "config": [
      "tests/browser/playwright.config.ts"
    ]
  }
}
