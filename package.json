{
  "name": "stream-sync",
  "private": true,
  "description": "Multi-platform livestream event pipeline for chat, TTS, viewer counts, and OBS overlays.",
  "main": "src/bootstrap.ts",
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/git-blame-dev/stream-sync.git"
  },
  "bugs": {
    "url": "https://github.com/git-blame-dev/stream-sync/issues"
  },
  "homepage": "https://github.com/git-blame-dev/stream-sync#readme",
  "scripts": {
    "build": "vite build --config gui/vite.config.ts",
    "build:release:linux": "bun scripts/release/build-artifact.ts linux-x64",
    "build:release:windows": "bun scripts/release/build-artifact.ts windows-x64",
    "dev": "vite --config gui/vite.config.ts",
    "gui:demo": "bun run build && tsx scripts/local/gui-demo.ts",
    "gui:preview": "bun run build && tsx scripts/local/gui-preview.ts",
    "gui:preview:once": "bun run build && tsx scripts/local/gui-preview.ts --once",
    "gui:preview:gift-animation": "bun run build && bun scripts/local/gui-gift-animation-preview.ts",
    "start": "bun src/bootstrap.ts",
    "start:debug": "bun src/bootstrap.ts --debug",
    "start:debug:build": "bun run build && bun src/bootstrap.ts --debug",
    "lint": "bun scripts/lint/no-raw-timeouts.ts && bun scripts/lint/no-mock-timers-in-tests.ts && bun scripts/lint/no-implementation-test-patterns.ts && bun scripts/lint/no-implicit-test-defaults.ts && bun scripts/lint/no-nondeterministic-test-values.ts && bun scripts/lint/prefer-double-bang.ts && bun x eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"tools/**/*.ts\" \"gui/**/*.{ts,tsx}\" && knip --config knip.json --include files,unlisted",
    "typecheck:gui": "tsc --noEmit -p gui/tsconfig.json",
    "typecheck:gui-node": "tsc --noEmit -p tsconfig.json",
    "typecheck:src": "tsc --noEmit -p tsconfig.src.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck:all": "bun run typecheck:src && bun run typecheck:tests && bun run typecheck:scripts && bun run typecheck:tools && bun run typecheck:gui && bun run typecheck:gui-node",
    "test": "NODE_ENV=test bun test",
    "test:coverage": "NODE_ENV=test bun test --coverage --coverage-reporter=text --coverage-dir=/tmp/bun-coverage tests",
    "verify": "bun run lint && bun run typecheck:all && bun run test:coverage && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/ini": "4.1.1",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@types/ws": "8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "globals": "14.0.0",
    "knip": "^6.43.0",
    "react-test-renderer": "^19.3.1",
    "tiktok-live-proto": "0.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "keywords": [
    "livestream",
    "twitch",
    "youtube",
    "tiktok",
    "obs",
    "typescript",
    "bun",
    "websocket",
    "event-driven"
  ],
  "license": "ISC",
  "patchedDependencies": {
    "youtubei.js@18.3.0": "patches/youtubei.js@18.3.0.patch"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "ini": "^6.0.0",
    "motion": "14.6.0",
    "obs-websocket-js": "^5.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "selfsigned": "^3.0.1",
    "tiktok-live-api-sdk": "0.4.0-beta1",
    "tiktok-live-connector": "2.5.0",
    "ws": "^8.22.0",
    "youtubei.js": "18.3.0"
  }
}
